p":false,"s":[["找到探案明信片！上面画着小猫和大树午睡前的小约定，我一直收在警长包里。",0]]},"mem_m2":{"who":"skye","comp":false,"s":[["是池塘明信片！那天荷叶亮晶晶的，小青蛙还在木头上给我们表演了三连跳呢。",0]]},"mem_m3":{"who":"labrador","comp":false,"s":[["这张草地照片太棒啦，小瓢虫停在我的警帽上，天天在旁边笑个不停。",0]]},"mem_m4":{"who":"skye","comp":false,"s":[["松果明信片！小猪挖出一颗比它还大的金色松果，请大家吃松果甜点。",0]]},"mem_m5":{"who":"labrador","comp":false,"s":[["树洞侦探站的纪念卡片，那时候小狐狸送了我们一个装满贴纸的木盒子。",0]]},"mem_m6":{"who":"skye","comp":false,"s":[["从天上看整片森林真美！母鸡在鸟窝里挥挥翅膀，跟我说早安。",0]]},"mem_m7":{"who":"labrador","comp":false,"s":[["小溪探险明信片！虽然大家脚上都沾了点软泥巴，可是拥抱在一起暖呼呼的。",0]]},"mem_m8":{"who":"skye","comp":false,"s":[["最亮的一张星光晚会明信片！全森林的好朋友都聚在一起敲鼓唱歌啦。",0]]},"me_labrador":{"who":"labrador","comp":false,"s":[["你好！我是拉布拉多警长。无论多小的线索，用放大镜仔细看都能找到，我们一起破案吧！",0]]},"me_skye":{"who":"skye","comp":false,"s":[["你好，我是天天！我会飞到树梢侦察线索，还要教你用自然拼读把英文单词大声拼出来！",0]]},"win":{"who":"skye","comp":false,"s":[["Yay!",1],["全森林的声音橡果都找回来啦！所有小动物都来参加星光晚会啦！",0]],"w":[["耶！",0],["全森林的声音橡果都找回来啦！所有小动物都来参加星光晚会啦！",0]]},"end":{"who":"labrador","comp":false,"s":[["真是一次了不起的森林大冒险，小侦探！快把今天拼出来的贴纸和照片收进我们的森林纪念册吧！",0]]},"tutor_tap":{"who":"skye","comp":false,"s":[["点一点发光的大树桩或草丛，就能把藏起来的声音橡果找出来哦！",0]]},"tutor_phonics":{"who":"skye","comp":false,"s":[["点下面的木头拼读音石，就能把单词拼完整！",0]]},"tutor_fullscreen":{"who":"skye","comp":false,"s":[["给大人的小提示：点右上角的全屏按钮，画面会更清楚哦。",0]]},"idle_1":{"who":"labrador","comp":false,"s":[["慢慢看，放大镜一直陪着你呢。",0]]},"idle_2":{"who":"skye","comp":false,"s":[["要不要看看闪亮的小树丛？点一点有惊喜哦！",0]]},"idle_3":{"who":"skye","comp":false,"s":[["不确定去哪儿的话，点右上角的小灯泡提示吧！",0]]},"idle_4":{"who":"labrador","comp":false,"s":[["先听一听发音，再点对应的音石，不着急。",0]]},"ui_play":{"who":"skye","comp":false,"s":[["开始探案",0]]},"ui_continue":{"who":"skye","comp":false,"s":[["继续探案",0]]},"ui_next":{"who":"skye","comp":false,"s":[["下一个",0]]},"ui_replay":{"who":"skye","comp":false,"s":[["再玩一次",0]]},"ui_back":{"who":"skye","comp":false,"s":[["回去",0]]},"ui_words":{"who":"skye","comp":false,"s":[["单词本",0]]},"ui_stickers":{"who":"skye","comp":false,"s":[["贴纸屋",0]]},"ui_wardrobe":{"who