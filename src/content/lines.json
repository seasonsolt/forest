  "lines": {
    "p1": {
      "who": "skye",
      "say": [
        "哇，拉布拉多警长！刚才一阵淘气的魔法风，把小动物们的声音橡果都吹散在森林里啦！"
      ],
      "art": "story_open"
    },
    "p2": {
      "who": "labrador",
      "say": [
        "别着急，天天。我带上放大镜，你在天上巡逻，我们一起找回声音橡果，帮大家拼好名字和动作！"
      ],
      "art": "story_open"
    },
    "p3": {
      "who": "skye",
      "say": [
        "太好啦！我先飞去橡果大树看看。出发喽，",
        {
          "en": "Hello!",
          "zh": "你好！"
        }
      ],
      "art": "key"
    },
    "ch_tree": {
      "who": "labrador",
      "say": [
        "第一站是橡果大树。点一点树洞和草丛，找出三颗发光的声音橡果吧！"
      ],
      "art": "bg_woods"
    },
    "ch_pond": {
      "who": "labrador",
      "say": [
        "池塘边有扑通扑通的水花声，我们在荷叶和石头底下找线索。"
      ],
      "art": "bg_pond"
    },
    "ch_meadow": {
      "who": "labrador",
      "say": [
        "阳光草地上草丛密密的，小动物就藏在花丛旁边。"
      ],
      "art": "bg_meadow"
    },
    "ch_hill": {
      "who": "labrador",
      "say": [
